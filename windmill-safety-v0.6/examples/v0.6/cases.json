    {
      "id": "fail-high-pressure-reverse",
      "changes": {
        "mode": "R",
        "pressure": 87,
        "untrusted_ingress": false
      },
      "expected": "FAIL"
    },
    {
      "id": "fail-dead-core",
      "changes": {
        "core_healthy": false
      },
      "expected": "FAIL"
    },
    {
      "id": "fail-common-failure",
      "changes": {
        "common_failure": true
      },
      "expected": "FAIL"
    },
    {
      "id": "fail-neutral-ingress",
      "changes": {
        "mode": "N"
      },
      "expected": "FAIL"
    },
    {
      "id": "fail-park-workers",
      "changes": {
        "mode": "P",
        "untrusted_ingress": false
      },
      "expected": "FAIL"
    },
    {
      "id": "fail-reverse-contact",
      "changes": {
        "mode": "R"
      },
      "expected": "FAIL"
    }
